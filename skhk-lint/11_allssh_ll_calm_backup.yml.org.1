---
- name: Importing initialization
  import_playbook: subr.local_init.yml

- name: Running ls -l /home/nutanix/tmp/calm-bkup
  hosts: calmcvm
#  hosts: allcvms
  gather_facts: true
  serial: 1

  vars:
    log_local_enabled: false
    log_ext_enabled: false
    log_github_enabled: false
    read_from_file: false
    logd_enabled: false
    role_enabled: false
    log_filesystem_enabled: false
    description: allssh 'ls -l /home/nutanix/tmp/calm-bkup'
    idx: idx100
    role: r_allssh_ll_calm_backup
    vpc: tbd

  tasks:
    - name: 1. Set csv_filename
      ansible.builtin.set_fact:
        csv_filename: "{{ hostvars['localhost']['csv_filename'] }}"

    - name: 2. Display csv_filename
      ansible.builtin.debug:
        msg: "{{ hostvars['localhost']['csv_filename'] }}"

    # ------------------------------------------------------------
    # UPFRONT REACHABILITY: Ensures the target control CVM itself is online
    # ------------------------------------------------------------
    - name: 3. Verify connectivity to the Control CVM
      ansible.builtin.wait_for_connection:
        timeout: 5
      register: control_cvm_status

    # ------------------------------------------------------------
    # SCENARIO 2: Run 'ls -l /home/nutanix/tmp/calm-bkup' and process the output
    # ------------------------------------------------------------
    - name: 4. Run "ls -l /home/nutanix/tmp/calm-bkup"
      ansible.builtin.include_tasks: subr.run_allssh.yml
      vars:
        target_cmd: "ls -l /home/nutanix/tmp/calm-bkup"
      when: not (read_from_file | bool)

    - name: 5. Initialise variable
      ansible.builtin.set_fact:
        no_of_files: 4

    - name: 6. Mimic 'cat' register output using lookup
      ansible.builtin.set_fact:
        input_filter:
          stdout: "{{ lookup('file', 'data.11_allssh_ll_calm_backup.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.11_allssh_ll_calm_backup.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool

    - name: 7. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}"

    - name: 8. Parse output and evaluate backup status
      ansible.builtin.set_fact:
        remark: >-
          {%- set context = {'current_ip': '', 'has_error': false, 'file_count': 0, 'logs': [], 'has_incomplete': false} -%}\
          {%- set lines = input_filter.stdout.split('\n') -%}
          {%- for line in lines -%}
            {%- if '==========' in line -%}
              {%- if context.current_ip != '' -%}
                {%- if context.has_error -%}
                  {%- set _ = context.logs.append(context.current_ip ~ ' - cannot access') -%}
                {%- elif context.file_count != no_of_files | int -%}
                  {%- set _ = context.logs.append(context.current_ip ~ ' - incomplete backup') -%}
                  {%- set _ = context.update({'has_incomplete': true}) -%}
                {%- endif -%}
              {%- endif -%}
              {%- set clean_ip = line | regex_replace('=+', '') | trim -%}
              {%- set _ = context.update({'current_ip': clean_ip, 'has_error': false, 'file_count': 0}) -%}
            {%- else -%}
              {%- if 'cannot access' in line -%}
                {%- set _ = context.update({'has_error': true}) -%}
              {%- endif -%}
              {%- if line.startswith('-') or line.startswith('l') -%}
                {%- set _ = context.update({'file_count': context.file_count + 1}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if context.current_ip != '' -%}
            {%- if context.has_error -%}
              {%- set _ = context.logs.append(context.current_ip ~ ' - cannot access') -%}
            {%- elif context.file_count != no_of_files | int -%}
              {%- set _ = context.logs.append(context.current_ip ~ ' - incomplete backup') -%}
              {%- set _ = context.update({'has_incomplete': true}) -%}
            {%- endif -%}
          {%- endif -%}
          {{ context.logs | join(' --- ') }}

    # xamllint disable rule:line-length
    - name: 9. Parse output and evaluate backup status
      ansible.builtin.set_fact:
        answer: >-
          {%- set context = {'current_ip': '', 'has_error': false, 'file_count': 0, 'has_incomplete': false} -%}
          {%- set lines = input_filter.stdout.split('\n') -%} {%- for line in lines -%}
            {%- if '==========' in line -%}
              {%- if context.current_ip != '' and not context.has_error and context.file_count != no_of_files | int -%}
                {%- set _ = context.update({'has_incomplete': true}) -%}
              {%- endif -%}
              {%- set clean_ip = line | regex_replace('=+', '') | trim -%}
              {%- set _ = context.update({'current_ip': clean_ip, 'has_error': false, 'file_count': 0}) -%}
            {%- else -%}
              {%- if 'cannot access' in line -%}
                {%- set _ = context.update({'has_error': true}) -%}
                {%- set _ = context.update({'has_incomplete': true}) -%}
            {%- endif -%}\{%- if line.startswith('-') or line.startswith('l') -%}
                {%- set _ = context.update({'file_count': context.file_count + 1}) -%}
          {%- endif -%}\{%- endif -%}\{%- endfor -%} {%- if context.current_ip != '' and not context.has_error and context.file_count != no_of_files | int -%}
            {%- set _ = context.update({'has_incomplete': true}) -%}
          {%- endif -%} {{ 'Incomplete backup' if context.has_incomplete else 'Complete backup' }}
    # xamllint enable rule:line-length

    - name: 9. Debug results
      ansible.builtin.debug:
        msg:
          - "Remark: {{ remark }}"
          - "Answer: {{ answer }}"

    - name: 97. Log to local
      ansible.builtin.import_tasks: subr.log_local.yml
      when: log_local_enabled | bool

    - name: 98. Log to external
      ansible.builtin.import_tasks: subr.log_ext.yml
      when: log_ext_enabled | bool

#    - name: 99. Log to local
#      ansible.builtin.import_tasks: subr.log_github.yml
#      when: log_github_enabled | bool
