
---------------------------------
dynamic_role_s15.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
- name: Run roles dynamically
  hosts: server_15
  gather_facts: no

  tasks:
    - name: Include roles per host
      include_role:
        name: "{{ item }}"
      loop: "{{ host_roles }}"
------------------------------------------------------------------


