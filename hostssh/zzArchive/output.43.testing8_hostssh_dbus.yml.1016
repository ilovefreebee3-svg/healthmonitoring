
---------------------------------
43.testing8_hostssh_dbus.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Pseudo hostssh - Check dbus across AHV Hosts
  hosts: corecvm
  gather_facts: false
  vars:
    remote_user_name: nutanix

  tasks:
    - name: Get AHV host IP addresses
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            hostips
      register: hostips_output
      changed_when: false

    - name: Parse IP addresses into a clean list
      ansible.builtin.set_fact:
        ahv_hosts: "{{ hostips_output.stdout | regex_findall('[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+') }}"

    - name: Initialize the empty input_result structures
      ansible.builtin.set_fact:
        input_result_stdout_list: []
        input_result_lines_list: []

    - name: Process each AHV host dynamically
      ansible.builtin.include_tasks:  subr.43.testing8_hostssh_dbus.yml
      loop: "{{ ahv_hosts }}"
      loop_control:
        loop_var: current_host
      when: ahv_hosts | length > 0

    - name: Construct final input_result dictionary
      ansible.builtin.set_fact:
        input_result:
          stdout: "{{ input_result_stdout_list | join('\n') }}"
          stdout_lines: "{{ input_result_lines_list }}"

    - name: Debug and display aggregate input_result outputs
      ansible.builtin.debug:
        var: input_result.stdout_lines

------------------------------------------------------------------


