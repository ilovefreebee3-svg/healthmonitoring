
---------------------------------
subr.20C.testing8_hostssh_fdisk_commands_sudo_become.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "Execute status check if {{ current_host }} is reachable"
  block:
    - name: Test basic connection
      ansible.builtin.ping:

    - name: Run commands sequentially on the target host
      ansible.builtin.command: "{{ current_command }}"
      delegate_to: "{{ current_host }}"
      vars:
        ansible_user: "{{ remote_user_name }}"
        # If current_host is an IP or hostname not in your inventory, 
        # you may also need to specify the private key if it isn't default:
        # ansible_ssh_private_key_file: "/path/to/your/key"
      become: true
      register: cmd_output
      loop:
        - 'fdisk -l'
      loop_control:
        loop_var: current_command

    - name: "1. Display list execution results for {{ current_host }}"
      ansible.builtin.debug:
        msg:
          - "HOST: {{ current_host }}"
          - "RESULTS:"
          - "{{ cmd_output.results | map(attribute='stdout_lines') | list }}"
          - "ERRORS:"
          - "{{ cmd_output.results | map(attribute='stderr') | list }}"

    - name: "2. Display no list execution results for {{ current_host }}"
      ansible.builtin.debug:
        msg:
          - "HOST: {{ current_host }}"
          - "RESULTS:"
          - "{{ cmd_output.results | map(attribute='stdout_lines') }}"
          - "ERRORS:"
          - "{{ cmd_output.results | map(attribute='stderr') }}"

  when: check_ssh.failed is not defined or not check_ssh.failed

------------------------------------------------------------------
