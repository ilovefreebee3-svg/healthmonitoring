
---------------------------------
subr.44.testing8_hostssh_dbus_logic.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# subr.yml
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "Execute status check if {{ current_host }} is reachable"
  block:
    - name: "Run systemctl status on {{ current_host }}"
      ansible.builtin.shell: "ssh -o StrictHostKeyChecking=no {{ remote_user_name }}@{{ current_host }} 'systemctl status dbus --no-pager'"
      register: cmd_output
      changed_when: false
      ignore_errors: true

    - name: "Display execution stderr when command fails on {{ current_host }}"
      ansible.builtin.debug:
        msg: "HOST {{ current_host }} FAILED. STDERR: {{ cmd_output.stderr }}"
      when: cmd_output.failed

    - name: "Format and collect execution strings"
      ansible.builtin.set_fact:
        host_header: "==================== {{ current_host }} ===================="
        host_stdout: "{{ cmd_output.stdout if not cmd_output.failed else cmd_output.stderr }}"
#        host_stdout: "{{ cmd_output.stdout }}"
        host_lines: "{{ cmd_output.stdout_lines if not cmd_output.failed else cmd_output.stderr_lines }}"
#        host_lines: "{{ cmd_output.stdout_lines }}"

    - name: "Append raw stdout block to accumulator"
      ansible.builtin.set_fact:
        input_result_stdout_list: "{{ input_result_stdout_list + [host_header, host_stdout, ''] }}"

    - name: "Append stdout_lines to accumulator"
      ansible.builtin.set_fact:
        input_result_lines_list: "{{ input_result_lines_list + [host_header] + host_lines + [''] }}"

    - name: "9. Display input_result_list {{ current_host }}"
      ansible.builtin.debug:
        msg: "{{ input_result_lines_list }}"

  when: check_ssh.failed is not defined or not check_ssh.failed


