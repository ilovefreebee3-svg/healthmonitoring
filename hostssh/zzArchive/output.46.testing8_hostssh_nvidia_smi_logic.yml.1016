
---------------------------------
46.testing8_hostssh_nvidia_smi_logic.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Pseudo hostssh - nvidia-smi across AHV Hosts
  hosts: corecvm
  gather_facts: false
  vars:
    remote_user_name: nutanix

  tasks:
    - name: 1. Get AHV host IP addresses
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            hostips
      register: hostips_output
      changed_when: false

    - name: 2. Parse IP addresses into a clean list
      ansible.builtin.set_fact:
        ahv_hosts: "{{ hostips_output.stdout | regex_findall('[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+') }}"

    - name: Initialize the empty input_filter structures
      ansible.builtin.set_fact:
        input_filter_stdout_list: []
        input_filter_lines_list: []

    - name: 3. Process each AHV host dynamically
      ansible.builtin.include_tasks: subr.46.testing8_hostssh_nvidia_smi.yml
      loop: "{{ ahv_hosts }}"
      loop_control:
        loop_var: current_host
      when: ahv_hosts | length > 0

    - name: 4. Construct final input_filter dictionary
      ansible.builtin.set_fact:
        input_filter:
          stdout: "{{ input_filter_stdout_list | join('\n') }}"
          stdout_lines: "{{ input_filter_lines_list }}"

#    - name: Debug and display aggregate input_filter outputs
#      ansible.builtin.debug:
#        var: input_filter.stdout_lines

#    - name: 4. Mimic 'cat' register output using lookup
#      set_fact:
#        input_result:
#          stdout: "{{ lookup('file', 'hostssh_nvidia_smi.txt') }}"
#          stdout_lines: "{{ lookup('file', 'hostssh_nvidia_smi.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false
    
    - name: 5. Display input_result.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 
    
    - name: 6. Match the regex
      set_fact:
        gpu_matches: >-
          {{ input_result.stdout | regex_findall('NVIDIA A100-SXM.*\n.*?(\d+)MiB / (\d+)MiB') }}
    
    - name: 7. Calculating 1 
      set_fact:
        answer: >-
          {% if gpu_matches | length == 0 %}
          None
          {% else %}
          {% set ns = namespace(exceed=false) %}
          {% for item in gpu_matches %}
            {% set used = item[0] | int %}
            {% set total = item[1] | int %}
            {% if (used / total) > 0.9 %}
              {% set ns.exceed = true %}
            {% endif %}
          {% endfor %}
          {{ 'Failed' if ns.exceed else 'Storage OK' }}
          {% endif %}
    
    - name: 8. Calculating 2 
      set_fact:
        remark: >-
          {% set ns = namespace(msg='') %}
          {% for item in gpu_matches %}
            {% set used = item[0] | int %}
            {% set total = item[1] | int %}
            {% if (used / total) > 0.9 %}
              {% set ns.msg = 'more than 0.9' %}
            {% endif %}
          {% endfor %}
          {{ ns.msg }}
    
    - name: 9. Display remark
      debug:
          var: remark
    
    - name: 10. Display answer
      debug:
          var: answer

    - name: Append result to CSV (local)
      import_tasks: logd.yml
------------------------------------------------------------------


