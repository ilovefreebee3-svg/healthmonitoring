
---------------------------------
07.testing10_hostssh_ovn_hostssh_commands.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: 1. Run hostssh ovn-appctl connection-status
  hosts: corecvm
#  hosts: engrcvm
#  hosts: pecvm
#  hosts: allcvms
  gather_facts: false
  serial: 1

  tasks:

    - name: 1. Declare variables
      set_fact:
        answer: "Healthy"
        remark: "No failures or errors detected."
        cmd_list:
          - name: hostssh ovn-appctl connection-status
            argv: ["hostssh", "ovn-appctl", "connection-status"]

#          - name: hostssh nvidia-smi
#            argv: ["hostssh", "nvidia-smi"]

#          - name: hostssh systemctl status nvidia-vgpu-mgr
#            argv: ["hostssh", "systemctl", "status","nvidia-vgpu-mgr"]

#          - name: hostssh systemctl list-units --type=service --no-pager
#            argv: ["hostssh", "systemctl", "list-units", "--type=service", "--no-pager"]

#          - name: hostssh systemctl status dbus
#            argv: ["hostssh", "systemctl", "status","dbus"]

    - name: 2. Execute commands
      include_tasks: subr.07.testing10_hostssh_ovn_hostssh_commands.yml
      loop: "{{ cmd_list }}"
      loop_control:
        loop_var: cmd

#    - name: 3. Mimic 'cat' register output using lookup
#      set_fact:
#        input_result:
#          stdout: "{{ lookup('file', 'data.hostssh_ovn_appctl_connection_status_PG.txt') }}"
#          stdout_lines: "{{ lookup('file', 'data.hostssh_ovn_appctl_connection_status_PG.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false

    - name: 4. Display input_result.stdout_lines
      ansible.builtin.debug:
        var: input_result.stdout_lines

    - name: 5. Display input_result.stdout
      ansible.builtin.debug:
        var: input_result.stdout

    - name: 6. Display input_result.stderr
      ansible.builtin.debug:
        var: input_result.stderr

    - name: 7. Display input_result.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 

    - name: 8. Display hostssh sudo ovn_appctl connection-status output
      ansible.builtin.debug:
        msg: "{{ input_result }}" 

    - name: 9. Split lines
      set_fact:
        lines: "{{ (input_result.stdout).split('\n') | map('trim') | reject('equalto','') | list }}"

    - name: 10. Initialize results
      set_fact:
        num_disconnected: 0
        remark: ""

    - name: 11. Process IP entries safely
      set_fact:
        num_disconnected: "{{ (num_disconnected | default(0) | int) + (1 if status != 'connected' else 0) }}"
        remark: >-
          {{
            remark +
            (ip ~ ' - ' ~ status ~ '; ' if status != 'connected' else '')
          }}
      loop: "{{ range(0, lines | length) | list }}"
      vars:
        current: "{{ lines[item] }}"
        next_line: "{{ lines[item + 1] if item + 1 < (lines | length) else '' }}"
        is_ip: "{{ current is search('=+\\s*[0-9.]+\\s*=+') }}"
        next_is_ip: "{{ next_line is search('=+') }}"
        ip: "{{ current | regex_search('([0-9.]+)') }}"
        status: >-
          {{
            (next_line if not next_is_ip else '')
          }}
      when: is_ip

    - name: Final answer
      set_fact:
        answer: "{{ 'Disconnected' if (num_disconnected | int) > 0 else 'Connected' }}"

    - debug:
        msg:
          num_disconnected: "{{ num_disconnected }}"
          remark: "{{ remark }}"
          answer: "{{ answer }}"

    - name: 12. Append result to CSV (local)
      import_tasks: logd.yml

#    - name: 99. Include common role
#      ansible.builtin.include_role:
#         name: common
------------------------------------------------------------------


