
---------------------------------
48.testing8_ovn_sudo_password.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Pseudo hostssh - Check ovn-appctl connection-status across AHV Hosts
  hosts: corecvm
  gather_facts: false
  vars:
    remote_user_name: nutanix

  tasks:
    - name: Get AHV host IP addresses
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            hostips
      register: hostips_output
      changed_when: false

    - name: Parse IP addresses into a clean list
      ansible.builtin.set_fact:
        ahv_hosts: "{{ hostips_output.stdout | regex_findall('[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+') }}"

    - name: Initialize the empty input_filter structures
      ansible.builtin.set_fact:
        input_filter_stdout_list: []
        input_filter_lines_list: []

    - name: Process each AHV host dynamically
      ansible.builtin.include_tasks: subr.48.testing8_ovn_sudo_password.yml
      loop: "{{ ahv_hosts }}"
      loop_control:
        loop_var: current_host
      when: ahv_hosts | length > 0

    - name: Construct final input_filter dictionary
      ansible.builtin.set_fact:
        input_filter:
          stdout: "{{ input_filter_stdout_list | join('\n') }}"
          stdout_lines: "{{ input_filter_lines_list }}"

    - name: Debug and display aggregate input_filter outputs
      ansible.builtin.debug:
        var: input_filter.stdout_lines

    - name: Mimic 'cat' register output using lookup
      set_fact:
        answer: "Healthy"
        remark: "No failures or errors detected."

    - name: Display hostssh sudo ovn-appctl connection-status output
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 

    - name: Split lines
      set_fact:
        lines: "{{ (input_filter.stdout).split('\n') | map('trim') | reject('equalto','') | list }}"

    - name: Initialize results
      set_fact:
        num_disconnected: 0
        remark: ""
#        idx: "idx to remove"
#        description: "descriptiion to remove"

    - name: Process IP entries safely
      set_fact:
        num_disconnected: "{{ (num_disconnected | default(0) | int) + (1 if status != 'connected' else 0) }}"
        remark: >-
          {{
            remark +
            (ip ~ ' - ' ~ status ~ '; ' if status != 'connected' else '')
          }}
      loop: "{{ range(0, lines | length) | list }}"
      vars:
        current: "{{ lines[item] }}"
        next_line: "{{ lines[item + 1] if item + 1 < (lines | length) else '' }}"
        is_ip: "{{ current is search('=+\\s*[0-9.]+\\s*=+') }}"
        next_is_ip: "{{ next_line is search('=+') }}"
        ip: "{{ current | regex_search('([0-9.]+)') }}"
        status: >-
          {{
            (next_line if not next_is_ip else '')
          }}
      when: is_ip

    - name: Final answer
      set_fact:
        answer: "{{ 'Disconnected' if (num_disconnected | int) > 0 else 'Connected' }}"

    - debug:
        msg:
          num_disconnected: "{{ num_disconnected }}"
          remark: "{{ remark }}"
          answer: "{{ answer }}"

    - name: Append result to CSV (local)
      import_tasks: logd.yml
------------------------------------------------------------------


