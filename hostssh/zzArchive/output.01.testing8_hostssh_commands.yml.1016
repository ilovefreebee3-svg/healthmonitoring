
---------------------------------
01.testing8_hostssh_commands.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: 1. Run diagnostic commands on all CVMs
#  hosts: corecvm
  hosts: allcvms
  gather_facts: false
  serial: 1

  vars:
    cmd_list:
      - name: hostips
        argv: ["hostips"]

      - name: nvidia-smi
        argv: ["nvidia-smi"]

      - name: systemctl is-active dbus
        argv: ["systemctl", "is-active","dbus"]

      - name: systemctl is-active nvidia-vgpu-mgr 
        argv: ["systemctl", "is-active","nvidia-vgpu-mgr"]

      - name: systemctl is-active nvidia-vgpu-mgr 
        argv: ["systemctl", "status","nvidia-vgpu-mgr"]

      - name: systemctl status nvidia-vgpu-mgr --no-pager
        argv: ["systemctl", "status","nvidia-vgpu-mgr"]

      - name: ovn-appctl connection-status
        argv: ["ovn-appctl", "connection-status"]

      - name: hostssh ovn-appctl connection-status
        argv: ["hostssh"]
      - name: systemctl list-units --type=service --no-pager
        argv: ["systemctl", "list-units", "--type=service", "--no-pager"]

  tasks:
    - name: 2. Execute commands
      include_tasks: subr.01.testing8_hosting_commands.yml
      loop: "{{ cmd_list }}"
      loop_control:
        loop_var: cmd
------------------------------------------------------------------


