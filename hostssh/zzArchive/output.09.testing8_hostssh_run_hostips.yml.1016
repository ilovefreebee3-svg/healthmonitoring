
---------------------------------
09.testing8_hostssh_run_hostips.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Extract and use Nutanix Host IPs
#  hosts: pecvm
  hosts: allcvms
  gather_facts: false

  tasks:
    - name: Execute hostips command inside Nutanix CVM
#      ansible.builtin.command: hostips
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            hostips
      register: hostips_output
      changed_when: false

    - name: Parse output into an Ansible list variable
      ansible.builtin.set_fact:
        physical_hosts: "{{ hostips_output.stdout.split() }}"

    - name: Display discovered physical hypervisor IPs
      ansible.builtin.debug:
        msg: "Discovered physical host IP: {{ item }}"
      loop: "{{ physical_hosts }}"

    # Example Action: Use the parsed list to execute an API check or a cross-ping
    - name: Verify network connectivity from CVM to each physical host
      ansible.builtin.command: "ping -c 2 {{ item }}"
      loop: "{{ physical_hosts }}"
      changed_when: false

------------------------------------------------------------------


