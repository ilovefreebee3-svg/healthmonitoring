
---------------------------------
subr.40.testing8_hostssh_misc.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "Display execution results for {{ current_host }}"
  ansible.builtin.debug:
    msg: 
      - "REMOTE_USER: {{ remote_user_name }}"
      - "CURRENT_HOST: {{ current_host }}"

- name: "Execute status check if {{ current_host }} is reachable"
  block:
    - name: "Run systemctl status on {{ current_host }}"
#      ansible.builtin.shell: "ssh -o StrictHostKeyChecking=no {{ remote_user_name }}@{{ current_host }} 'sudo systemctl status nvidia_vgpu_mgr --no-pager'"
#      ansible.builtin.shell: "ssh -o StrictHostKeyChecking=no {{ remote_user_name }}@{{ current_host }} 'nvidia-smi'"
#      ansible.builtin.shell: "ssh -o StrictHostKeyChecking=no {{ remote_user_name }}@{{ current_host }} 'sudo ovn-appctl connection-status'"
      ansible.builtin.command: ssh -o StrictHostKeyChecking=no -o BatchMode=yes -i "~/.ssh/id_rsa" {{ remote_user_name }}@{{ current_host }} "systemctl status dbus" 
#      ansible.builtin.shell:  ssh -o StrictHostKeyChecking=no -o BatchMode=yes -i "~/.ssh/id_rsa" nutanix@130.8.20.21 "hostname"

      register: cmd_output
      changed_when: false
      ignore_errors: true

    - name: "Display execution results for {{ current_host }}"
      ansible.builtin.debug:
        msg: 
          - "HOST: {{ current_host }}"
          - "STDOUT: {{ cmd_output.stdout }}"
          - "STDERR: {{ cmd_output.stderr if cmd_output.failed else 'None' }}"

  when: check_ssh.failed is not defined or not check_ssh.failed

------------------------------------------------------------------
