
---------------------------------
subr.22.testing8_hostssh_ovn_sudo_password.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "apt update if {{ current_host }} is reachable"
  block:
    - name: "1. sudo ovn-appctl connection-status on {{ current_host }}"
      ansible.builtin.shell: "ssh -o StrictHostKeyChecking=no {{ remote_user_name }}@{{ current_host }} sudo ovn-appctl connection-status"
      vars:
         local_sudo_password: "1"
      register: input_result
      changed_when: false
      ignore_errors: true

    - name: " 2. Display sudo apt update results for {{ current_host }}"
      ansible.builtin.debug:
        msg: 
          - "HOST: {{ current_host }}"
          - "STDLNE: {{ input_result.stdout_lines }}"
          - "STDERR: {{ input_result.stderr if input_result.failed else 'None' }}"
#          - "STDOUT: {{ input_result.stdout }}"

  when: check_ssh.failed is not defined or not check_ssh.failed

------------------------------------------------------------------
