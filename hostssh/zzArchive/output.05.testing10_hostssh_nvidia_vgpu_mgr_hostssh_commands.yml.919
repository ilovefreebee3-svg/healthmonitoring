
---------------------------------
05.testing10_hostssh_nvidia_vgpu_mgr_hostssh_commands.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: 1. Run diagnostic commands on all CVMs
  hosts: corecvm
#  hosts: allcvms
  gather_facts: false
  serial: 1

  tasks:

    - name: 1. Declare variables
      set_fact:
        answer: "Healthy"
        remark: "No failures or errors detected."
        cmd_list:
#          - name: hostssh ovn-appctl connection-status
#            argv: ["hostssh", "ovn-appctl", "connection-status"]

#          - name: hostssh nvidia-smi
#            argv: ["hostssh", "nvidia-smi"]

          - name: hostssh systemctl status nvidia-vgpu-mgr
            argv: ["hostssh", "systemctl", "status","nvidia-vgpu-mgr"]

#          - name: hostssh systemctl list-units --type=service --no-pager
#            argv: ["hostssh", "systemctl", "list-units", "--type=service", "--no-pager"]

#          - name: hostssh systemctl status dbus
#            argv: ["hostssh", "systemctl", "status","dbus"]

    - name: 2. Execute commands
      include_tasks: subr.05.testing10_hostssh_nvidia_vgpu_mgr_hostssh_commands.yml
      loop: "{{ cmd_list }}"
      loop_control:
        loop_var: cmd

#    - name: 3. Mimic 'cat' register output using lookup
#      set_fact:
#        input_result:
#          stdout: "{{ lookup('file', 'data.hostssh_systemctl_status_nvidia_vgpu_mgr.txt') }}"
#          stdout_lines: "{{ lookup('file', 'data.hostssh_systemctl_status_nvidia_vgpu_mgr.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false

    - name: 4. Display input_result.stdout_lines
      ansible.builtin.debug:
        var: input_result.stdout_lines

    - name: 5. Display input_result.stdout
      ansible.builtin.debug:
        var: input_result.stdout

    - name: 6. Display input_result.stderr
      ansible.builtin.debug:
        var: input_result.stderr

    - name: 7. Display input_result.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 

    - set_fact:
        svc_list: >-
          {{
            input_result.stdout | regex_findall(
            '={1,20}\s*([0-9.]+)\s*={1,20}.*?\n.*?(nvidia-vgpu-mgr\.service).*?\n.*?\n.*?Active:\s+(\w+)',
            multiline=True
            )
          }}
    
    - name: 9. Determine svc_list
      debug:
        var: svc_list

    - set_fact:
        answer: "None"
      when: svc_list | length == 0
    
    - set_fact:
        inactive_list: "{{ svc_list | rejectattr('2', 'equalto', 'active') | list }}"
      when: svc_list | length > 0
    
    - set_fact:
        answer: >-
          {{ 'All active' if inactive_list | length == 0 else 'Not all active' }}
        remark: >-
          {{ inactive_list if inactive_list | length > 0 else '' }}
      when: svc_list | length > 0

    - name: 10. Display answer and remark
      debug:
        msg: "{{ answer }} {{ remark }} "

    - name: 11. Append result to CSV (local)
      import_tasks: logd.yml

#    - name: 99. Include common role
#      ansible.builtin.include_role:
#         name: common

------------------------------------------------------------------


