
---------------------------------
subr.26.testing8_hostssh_ovn_sudo_become.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "Execute status check if {{ current_host }} is reachable"
  block:
    - name: Test basic connection
      ansible.builtin.ping:

    - name: Run fdisk directly on the target host
      ansible.builtin.command: ovn-appctl connection-status
      delegate_to: "{{ current_host }}"
      vars:
        ansible_user: "{{ remote_user_name }}"
        # If current_host is an IP or hostname not in your inventory, 
        # you may also need to specify the private key if it isn't default:
        # ansible_ssh_private_key_file: "/path/to/your/key"
      become: true
      register: input_result
      ignore_errors: true

    - name: "Display execution results for {{ current_host }}"
      ansible.builtin.debug:
        msg: 
          - "HOST: {{ current_host }}"
          - "STDLNE: {{ input_result.stdout_lines }}"
          - "STDERR: {{ input_result.stderr if input_result.failed else 'None' }}"
#          - "STDOUT: {{ input_result.stdout }}"

  when: check_ssh.failed is not defined or not check_ssh.failed

------------------------------------------------------------------
