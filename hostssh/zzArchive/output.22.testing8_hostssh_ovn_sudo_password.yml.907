
---------------------------------
22.testing8_hostssh_ovn_sudo_password.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Pseudo hostssh - Check nvidia_vgpu_mgr Status across AHV Hosts
  hosts: corecvm
  gather_facts: false
#  become: true
  vars:
    remote_user_name: nutanix

  tasks:
    - name: Get AHV host IP addresses
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            hostips
      register: hostips_output
      changed_when: false

    - name: Parse IP addresses into a clean list
      ansible.builtin.set_fact:
        ahv_hosts: "{{ hostips_output.stdout | regex_findall('[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+') }}"

    - name: Process each AHV host dynamically
      ansible.builtin.include_tasks: subr.22.testing8_hostssh_ovn_sudo_password.yml
      loop: "{{ ahv_hosts }}"
      loop_control:
        loop_var: current_host
      when: ahv_hosts | length > 0

------------------------------------------------------------------


