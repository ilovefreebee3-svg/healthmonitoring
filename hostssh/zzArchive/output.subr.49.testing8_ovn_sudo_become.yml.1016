
---------------------------------
subr.49.testing8_ovn_sudo_become.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: "Check reachability for {{ current_host }}"
  ansible.builtin.wait_for:
    host: "{{ current_host }}"
    port: 22
    state: started
    timeout: 3
  register: check_ssh
  ignore_errors: true

- name: "Execute status check if {{ current_host }} is reachable"
  block:
    - name: Test basic connection
      ansible.builtin.ping:

    - name: Run commands sequentially on the target host
      ansible.builtin.command: "ovn-appctl connection-status"
      delegate_to: "{{ current_host }}"
      vars:
        ansible_user: "{{ remote_user_name }}"
        # If current_host is an IP or hostname not in your inventory, 
        # you may also need to specify the private key if it isn't default:
        # ansible_ssh_private_key_file: "/path/to/your/key"
      become: true
      register: cmd_output
      ignore_errors: true

    - name: "1. Display execution stderr when command fails on {{ current_host }}"
      ansible.builtin.debug:
        msg: "HOST {{ current_host }} FAILED. STDERR: {{ cmd_output.stderr }}"
      when: cmd_output.failed

    - name: "2. Format and collect execution strings"
      ansible.builtin.set_fact:
        host_header: "==================== {{ current_host }} ===================="
        host_stdout: "{{ cmd_output.stdout if not cmd_output.failed else cmd_output.stderr }}"
        host_lines: "{{ cmd_output.stdout_lines if not cmd_output.failed else cmd_output.stderr_lines }}"

    - name: "3. Append raw stdout block to accumulator"
      ansible.builtin.set_fact:
        input_filter_stdout_list: "{{ input_filter_stdout_list + [host_header, host_stdout, ''] }}"

    - name: "4. Append stdout_lines to accumulator"
      ansible.builtin.set_fact:
        input_filter_lines_list: "{{ input_filter_lines_list + [host_header] + host_lines + [''] }}"

  when: check_ssh.failed is not defined or not check_ssh.failed

------------------------------------------------------------------
