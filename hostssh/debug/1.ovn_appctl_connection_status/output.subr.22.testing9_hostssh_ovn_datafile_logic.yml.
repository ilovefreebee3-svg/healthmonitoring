- name: 13. Mimic 'cat' register output using lookup
  set_fact:
    answer: "Healthy"
    remark: "No failures or errors detected."
    input_filter:
      stdout: "{{ lookup('file', ' data.hostssh_ovn_appctl_connection_status.txt') }}"
      stdout_lines: "{{ lookup('file', ' data.hostssh_ovn_appctl_connection_status.txt').splitlines() }}"
      rc: 0
      failed: false
      changed: false

- name: 14. Debug the captured output
  ansible.builtin.debug:
    var: input_filter.stdout_lines

- name: 15. Display the captured output
  ansible.builtin.debug:
    var: input_filter.stdout

- name: 16. Display {{ cmd.argv }} command output
  debug:
    msg: |
      ==================================================
      Host    : {{ inventory_hostname }}
      Command : {{ cmd.name }}
      RC      : {{ input_filter.rc }}

      STDOUT:
      {{ input_filter.stdout_lines | default('') }}

      STDERR:
      {{ input_filter.stderr | default('') }}
      ==================================================

- name: 17. Log output on control node
  ansible.builtin.blockinfile:
    path: ./tmp/00_run_all_hostssh_commands.log
    create: true
    marker: ""
    block: |
      ==================================================
      Host    : {{ inventory_hostname }}
      Command : {{ cmd.name }}
      RC      : {{ input_filter.rc }}

      STDOUT:
      {{ input_filter.stdout_lines | default('') }}

      STDERR:
      {{ input_filter.stderr | default('') }}
      ==================================================
  delegate_to: localhost
