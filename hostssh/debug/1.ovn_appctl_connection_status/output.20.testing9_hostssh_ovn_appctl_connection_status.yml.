- name: Analyze connection status
  hosts: server_15
  gather_facts: no

  tasks:
#    - name: Run all NCC health checks
#      ansible.builtin.command: hostssh_sudo_ovn_appctl_connection_status
#      register: input_result
#      ignore_errors: true

    - name: Mimic 'cat' register output using lookup
      set_fact:
        answer: "Healthy"
        remark: "No failures or errors detected."
        input_result:
          stdout: "{{ lookup('file', 'data.hostssh_ovn_appctl_connection_status.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.hostssh_ovn_appctl_connection_status.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false

    - name: Display hostssh sudo ovn_appctl connection-status output
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 

    - name: Split lines
      set_fact:
        lines: "{{ (input_result.stdout).split('\n') | map('trim') | reject('equalto','') | list }}"

    - name: Initialize results
      set_fact:
        num_disconnected: 0
        remark: ""

    - name: Process IP entries safely
      set_fact:
        num_disconnected: "{{ (num_disconnected | default(0) | int) + (1 if status != 'connected' else 0) }}"
        remark: >-
          {{
            remark +
            (ip ~ ' - ' ~ status ~ '; ' if status != 'connected' else '')
          }}
      loop: "{{ range(0, lines | length) | list }}"
      vars:
        current: "{{ lines[item] }}"
        next_line: "{{ lines[item + 1] if item + 1 < (lines | length) else '' }}"
        is_ip: "{{ current is search('=+\\s*[0-9.]+\\s*=+') }}"
        next_is_ip: "{{ next_line is search('=+') }}"
        ip: "{{ current | regex_search('([0-9.]+)') }}"
        status: >-
          {{
            (next_line if not next_is_ip else '')
          }}
      when: is_ip

    - name: Final answer
      set_fact:
        answer: "{{ 'Disconnected' if (num_disconnected | int) > 0 else 'Connected' }}"

    - debug:
        msg:
          num_disconnected: "{{ num_disconnected }}"
          remark: "{{ remark }}"
          answer: "{{ answer }}"

    - name: Append result to CSV (local)
      import_tasks: logd.yml
