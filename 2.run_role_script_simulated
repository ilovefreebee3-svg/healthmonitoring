post=$post1.$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))




for file in "${files[@]}"; do
    if [ -f "$file" ]; then
        
        outfile=output."$file"."$post"

        echo Processing "$file" started
        echo "" > $outfile
        echo "---------------------------------" >> $outfile
        echo "$file" >> $outfile
        echo "---------------------------------" >> $outfile
        echo "" >> $outfile

        echo "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++" >> $outfile
        cat "$file" >> $outfile
        echo "------------------------------------------------------------------" >> $outfile


        if [[ ${file:0:4} != 'subr' ]]; then
           echo "" >> $outfile
           echo "" >> $outfile
           echo aphe "$file" >> $outfile
           echo "" >> $outfile
           aphe "$file" >> $outfile
           echo Processing "$file" finished
           echo
#           sleep 1
        fi
    else
        echo "Error: $file not found."
    fi
done


