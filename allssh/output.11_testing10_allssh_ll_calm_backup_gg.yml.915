
---------------------------------
11_testing10_allssh_ll_calm_backup_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Master Playbook to Execute and Process Multiple AllSSH Commands
#  hosts: calmcvm
  hosts: allcvms
  gather_facts: false

  tasks:
    # ------------------------------------------------------------
    # UPFRONT REACHABILITY: Ensures the target control CVM itself is online
    # ------------------------------------------------------------
    - name: 1. Verify connectivity to the Control CVM
      ansible.builtin.wait_for_connection:
        timeout: 5
      register: control_cvm_status

    # ------------------------------------------------------------
    # SCENARIO 2: Run 'ls -l /home/nutanix/tmp/calm-bkup' and process the output
    # ------------------------------------------------------------
    - name: 2. Run "ls -l /home/nutanix/tmp/calm-bkup"
      ansible.builtin.include_tasks: subr.run_allssh.yml
      vars:
        target_cmd: "ls -l /home/nutanix/tmp/calm-bkup"

    - name: 3. Initialise variable
      set_fact:
        no_of_files: 4

#    - name: Mimic 'cat' register output using lookup
#      set_fact:
#        input_filter:
#          stdout: "{{ lookup('file', 'data.allssh_ll_calm_backup_gg.txt') }}"
#          stdout_lines: "{{ lookup('file', 'data.allssh_ll_calm_backup_gg.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false

    - name: 4. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 

    - name: 5. Parse output and evaluate backup status
      ansible.builtin.set_fact:
        remark: >-
          {%- set context = {'current_ip': '', 'has_error': false, 'file_count': 0, 'logs': [], 'has_incomplete': false} -%}
          {%- set lines = input_filter.stdout.split('\n') -%}
          
          {# Local macro to evaluate a block before transitioning to a new IP or ending #}
          {%- macro evaluate_block(ctx) -%}
            {%- if ctx.current_ip != '' -%}
              {%- if ctx.has_error -%}
                {%- set _ = ctx.logs.append(ctx.current_ip ~ ' - cannot access') -%}
              {%- elif ctx.file_count != no_of_files | int -%}
                {%- set _ = ctx.logs.append(ctx.current_ip ~ ' -  incomplete backup') -%}
                {%- set _ = ctx.update({'has_incomplete': true}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endmacro -%}

          {# Loop through lines sequentially #}
          {%- for line in lines -%}
            {%- if '==========' in line -%}
              {{ evaluate_block(context) }}
              {%- set clean_ip = line | regex_replace('=+', '') | trim -%}
              {%- set _ = context.update({'current_ip': clean_ip, 'has_error': false, 'file_count': 0}) -%}
            {%- else -%}
              {%- if 'cannot access' in line -%}
                {%- set _ = context.update({'has_error': true}) -%}
              {%- endif -%}
              {%- if line.startswith('-') or line.startswith('l') -%}
                {%- set _ = context.update({'file_count': context.context_file_count | default(context.file_count) + 1}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          {# Evaluate the final block #}
          {{ evaluate_block(context) }}
          
          {# Output the results separating logs with your custom delimiter #}
          {{ context.logs | join(' --- ') }}

        answer: >-
          {%- set context = {'current_ip': '', 'has_error': false, 'file_count': 0, 'has_incomplete': false} -%}
          {%- set lines = input_filter.stdout.split('\n') -%}
          
          {%- macro check_incomplete(ctx) -%}
            {%- if ctx.current_ip != '' and not ctx.has_error and ctx.file_count != no_of_files | int -%}
              {%- set _ = ctx.update({'has_incomplete': true}) -%}
            {%- endif -%}
          {%- endmacro -%}

          {%- for line in lines -%}
            {%- if '==========' in line -%}
              {{ check_incomplete(context) }}
              {%- set clean_ip = line | regex_replace('=+', '') | trim -%}
              {%- set _ = context.update({'current_ip': clean_ip, 'has_error': false, 'file_count': 0}) -%}
            {%- else -%}
              {%- if 'cannot access' in line -%}
                {%- set _ = context.update({'has_error': true}) -%}
              {%- endif -%}
              {%- if line.startswith('-') or line.startswith('l') -%}
                {%- set _ = context.update({'file_count': context.file_count + 1}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {{ check_incomplete(context) }}
          
          {{ 'Incomplete backup' if context.has_incomplete else 'Complete backup' }}

    - name: 6. Debug results
      ansible.builtin.debug:
        msg:
          - "Remark: {{ remark }}"
          - "Answer: {{ answer }}"

    - name: 7. Append result to CSV (local)
      import_tasks: logd.yml

#    - name: 99. Include common role
#      ansible.builtin.include_role:
#         name: common

    
