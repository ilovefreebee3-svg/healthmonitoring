
---------------------------------
10_testing8_mspctl_cluster_list_logic.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Monitor MSP Component Status
  hosts: allcvms
  gather_facts: false
  vars:
    # Initialize variables with default healthy states
    answer: "healthy"
    remark: []

  tasks:
    - name: Run MSP status command
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            mspctl cluster list 
      register: msp_list_output
      changed_when: false
      failed_when: false

    - name: 2. Display the command module raw diagnostic logs
      ansible.builtin.debug:
        var: msp_list_output.stdout_lines

    - name: 3. Display the command module raw diagnostic logs
      ansible.builtin.debug:
        var: msp_list_output.stdout

    - name: 4. Display the command module raw diagnostic logs
      ansible.builtin.debug:
        var: msp_list_output

    - name: 5. Extract cluster names from list
      ansible.builtin.set_fact:
        # Skips the header row and captures the first column (NAME)
        cluster_names: >-
          {{ msp_list_output.stdout_lines[1:] 
             | map('regex_findall', '^\s*(\S+)') 
             | map('first') 
             | list }}

    - name: 6. Run health check for each discovered cluster
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            "mspctl cluster health {{ item }}"
      failed_when: false
      register: msp_health_results
      changed_when: false
      loop: "{{ cluster_names }}"

    - name: 7. Parse and isolate unhealthy clusters
      ansible.builtin.set_fact:
        # Filters loops where the health output text contains 'false' or 'unhealthy'
        unhealthy_clusters: >-
          {{ msp_health_results.results 
             | selectattr('stdout', 'search', '(?i)false|unhealthy') 
             | map(attribute='item') 
             | list }}

    - name: 8. Update final variables if any unhealthy clusters exist
      ansible.builtin.set_fact:
        answer: "unhealthy"
        remark: "{{ unhealthy_clusters }}"
      when: unhealthy_clusters | length > 0

    - name: 9. Debug health results
      ansible.builtin.debug:
        msg:
          - "Final Answer: {{ answer }}"
          - "Final Remark: {{ remark }}"

