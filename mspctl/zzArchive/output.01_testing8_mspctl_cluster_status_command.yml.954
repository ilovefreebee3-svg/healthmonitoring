
---------------------------------
01_testing8_mspctl_cluster_status_command.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: how to run mspctl cluster status
  hosts: allcvms
  gather_facts: false

  tasks:
    - name: 1. Run mspctl cluster status with command module
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            mspctl cluster status 
      register: input_result
      changed_when: false
      failed_when: false

    - name: 2. Display the command module raw diagnostic logs
      ansible.builtin.debug:
        var: input_result.stdout_lines

#    - name: 3. Display the command module raw diagnostic logs
#      ansible.builtin.debug:
#        var: input_result.stdout

