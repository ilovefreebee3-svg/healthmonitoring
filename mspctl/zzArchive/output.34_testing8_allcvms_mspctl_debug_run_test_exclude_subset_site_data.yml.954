
---------------------------------
34_testing8_allcvms_mspctl_debug_run_test_exclude_subset_site_data.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: how to run mspctl
#  hosts: pccvm
  hosts: allcvms
  gather_facts: false

  tasks:
    - name: 1. Run mspctl debug --test_exclude_subnet=hosting_pe with command module
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            mspctl debug run --test_exclude_subset=hosting_pe
      register: input_result
      changed_when: false
      failed_when: false

    - name: 2. Display the raw script output
      ansible.builtin.debug:
        var: input_result.stdout_lines

    - name: 3. Display the raw script output
      ansible.builtin.debug:
        var: input_result.stdout

    - name: 4. Remove ANSI color codes
      ansible.builtin.set_fact:
        Xinput_result_msg: >-
          {{
            input_result.stdout_lines
            | map('regex_replace', '\x1B\[[0-9;]*[A-Za-z]', '')
            | list
          }}
    
    - name: 5. Display cleaned output
      ansible.builtin.debug:
        var: Xinput_result_msg

    - name: 6. Display input_result.stdout_lines
      ansible.builtin.debug:
        msg:
          - "V: {{ input_result.stdout_lines }}"

    - name: 7. Display Xinput_Result msg
      ansible.builtin.debug:
        msg:
          - "X: {{ Xinput_result_msg }}"

    - name: 8. Initialize variables
      set_fact:
        current_name: ""
        failures: []
        test_results: []

    - name: 9. Parse in ONE loop (correct pairing)
      set_fact:
        current_name: >-
          {{
            item.split(':', 1)[1] | trim
            if item is search('^Test Name:')
            else current_name
          }}

        test_results: >-
          {{
            test_results + [ {'name': current_name, 'status': item.split(':',1)[1] | trim} ]
            if item is search('^STATUS:')
            else test_results
          }}

        failures: >-
          {{
            failures + [ {'name': current_name, 'status': item.split(':',1)[1] | trim} ]
            if (item is search('^STATUS:') and (item.split(':',1)[1] | trim) != 'SUCCESS')
            else failures
          }}

      loop: "{{ Xinput_result_msg }}"

    - name: 10. Compute summary
      set_fact:
        num_failure: "{{ failures | length }}"
        remark: >-
          {{
            failures
            | map(attribute='name')
            | zip(failures | map(attribute='status'))
            | map('join', ' -> ')
            | join(' -- ')
          }}
        answer: "{{ 'STATUS Not Success' if (failures | length) > 0 else 'STATUS SUCCESS' }}"

    - debug:
        msg:
          - "Failures: {{ num_failure }}"
          - "Remark: {{ remark }}"
          - "Answer: {{ answer }}"

    - name: 8. Append result to CSV (local)
      import_tasks: logd.yml
------------------------------------------------------------------


