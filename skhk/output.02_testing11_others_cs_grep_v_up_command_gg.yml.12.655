
---------------------------------
02_testing11_others_cs_grep_v_up_command_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Check CVM cluster status
  hosts: server_12
  gather_facts: false
  vars:
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    log_github_enabled: false 
    description: cs | grep -v UP
    idx: idx059
    role: r_cs_grep_v_up_gg

  tasks:
    - name: 0. Declare variables
      set_fact:
        down_services: []

    - name: 1. Execute /home/nutanix/cluster/bin/cluster status
      ansible.builtin.command: /home/nutanix/cluster/bin/cluster status
      register: input_filter
      changed_when: false
      ignore_errors: true
      when: not (read_from_file | bool)

    - name: 3. Read from hardcoded file
      set_fact:
        input_filter:
          stdout: "{{ lookup('file', 'data.02_testing11_others_cs_grep_v_up_command_gg.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.02_testing11_others_cs_grep_v_up_command_gg.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool
    
    - name: 4. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 
    
    - name: 5. Parse output and evaluate status
      ansible.builtin.set_fact:
        down_services: >-
          {%- set lines = input_filter.stdout_lines -%}
          {%- set filtered = [] -%}
          {%- for raw_line in lines -%}
            {%- set line = raw_line.replace(',', ' ') -%}
            {%- if 'CVM:' in line -%}
              {%- set cols = line.split() -%}
              {%- if cols | length >= 3 and cols[2] != 'Up' -%}
                {%- set _ = filtered.append({'ip': cols[1], 'status': cols[2]}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {{ filtered }}
    
    - name: 6. Set final answer and remark variables
      ansible.builtin.set_fact:
        answer: "{{ 'CVM service(s) down' if down_services | length > 0 else 'CVM service(s) all Up' }}"
        remark: "{{ down_services if down_services | length > 0 else 'All services healthy' }}"
    
    - name: 7. Display results
      ansible.builtin.debug:
        msg:
          - "Answer: {{ answer }}"
          - "Remark: {{ remark }}"
    
    - name: 99. Include persistency
      ansible.builtin.include_tasks: incl.logging.yml
------------------------------------------------------------------


