
---------------------------------
14_testing11_allssh_df_kh_grep_elastic_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Running df -kh
#  hosts: calmcvm
  hosts: calmcvm
  gather_facts: true

  vars:
    log_local_enabled: false 
    log_ext_enabled: false 
    log_github_enabled: false 
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    description: allssh 'df -kh | grep -e elastic '
    idx: idx099
    role: r_allssh_df_kh_grep_elastic_sdb3_gg
    vpc: tbd

  tasks:
    - name: 0. Initialising csv_filename
      import_tasks: subr.log_settings.yml

    # ------------------------------------------------------------
    # UPFRONT REACHABILITY: Ensures the target control CVM itself is online
    # ------------------------------------------------------------
    - name: Verify connectivity to the Control CVM
      ansible.builtin.wait_for_connection:
        timeout: 5
      register: control_cvm_status

    # ------------------------------------------------------------
    # SCENARIO 2: Run 'df -kh' and process the output
    # ------------------------------------------------------------
    - name: 1. Run df -kh and status check across all CVMs
      ansible.builtin.include_tasks: subr.run_allssh.yml
      vars:
        target_cmd: "df -kh"
      when: not ( read_from_file | bool )

    - name: 3. Read from hardcoded file
      set_fact:
        input_filter:
          stdout: "{{ lookup('file', 'data.14_testing11_allssh_df_kh_grep_elastic_gg.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.14_testing11_allssh_df_kh_grep_elastic_gg.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool

    - name: 4. Initialise variables
      set_fact:
        remark_list: []
        status_tracker: []

    - name: 5. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 

    - name: 6. Isolate blocks by delimiter
      ansible.builtin.set_fact:
        raw_blocks: "{{ input_filter.stdout.split('==========') }}"

    - name: 7. Process each host block dynamically
      ansible.builtin.set_fact:
        current_ip: "{{ raw_blocks[block_idx] | replace('=', '') | trim }}"
        current_content: "{{ raw_blocks[block_idx + 1] | default('') }}"
      loop: "{{ range(1, raw_blocks | length, 2) | list }}"
      loop_control:
        loop_var: block_idx
      register: block_results

    - name: 8. Aggregate results into final structures
      ansible.builtin.set_fact:
        remark_list: >-
          {{ remark_list + [ 
          registered_result.ansible_facts.current_ip ~ ' --- ' ~ 
          ('Elasticsearch function found' if 'elasticsearch' in registered_result.ansible_facts.current_content else 'Elasticsearch function not found') 
          ] }}
        status_tracker: >-
          {{ status_tracker + [ 
          'found' if 'elasticsearch' in registered_result.ansible_facts.current_content else 'not found' 
          ] }}
      loop: "{{ block_results.results }}"
      loop_control:
        loop_var: registered_result

    - name: 9. Finalise scalar answer and remark variables
      ansible.builtin.set_fact:
        remark: "{{ remark_list | join('\n') }}"
        answer: "{{ 'Elasticsearch function not found' if 'not found' in status_tracker else 'Elasticsearch function found' }}"

    - name: 10. Display Results
      ansible.builtin.debug:
        msg:
          - "REMARK:"
          - "{{ remark }}"
          - "-----------------------------------"
          - "ANSWER: {{ answer }}"

    - name: 97. Log to local
      import_tasks: subr.log_local.yml
      when: log_local_enabled | bool

    - name: 98. Log to external
      import_tasks: subr.log_ext.yml
      when: log_ext_enabled | bool

    - name: 99. Log to local
      import_tasks: subr.log_github.yml
      when: log_github_enabled | bool

