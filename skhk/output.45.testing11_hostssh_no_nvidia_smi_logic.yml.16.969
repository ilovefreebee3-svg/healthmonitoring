# 45.testing11_hostssh_nvidia_smi_logic.yml
---
- name: Pseudo hostssh - nvidia-smi across AHV Hosts
  hosts: corecvm
  gather_facts: true

  vars:
    log_local_enabled: false 
    log_ext_enabled: false 
    log_github_enabled: false 
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    description: hostssh nvidia-smi
    idx: idx016
    role: r_hostssh_nvidia-smi
    vpc: tbd

  tasks:
    - name: 0. Initialising csv_filename
      import_tasks: subr.log_settings.yml

    - name: Process AHV hosts configuration and tracking
      when: not (read_from_file | bool)
      block:
        - name: 0. Declare variables
          set_fact:
            remote_user_name: nutanix
    
        - name: 1. Get AHV host IP addresses
          ansible.builtin.command:
            argv:
              - /bin/bash
              - -c
              - |
                source /etc/profile
                hostips
          register: hostips_output
          changed_when: false
    
        - name: 2. Parse IP addresses into a clean list
          ansible.builtin.set_fact:
            ahv_hosts: "{{ hostips_output.stdout | regex_findall('[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+') }}"
    
        - name: Initialize the empty input_filter structures
          ansible.builtin.set_fact:
            input_filter_stdout_list: []
            input_filter_lines_list: []
    
        - name: 3. Process each AHV host dynamically
          ansible.builtin.include_tasks: subr.45.testing11_hostssh_no_nvidia_smi_logic.yml
          loop: "{{ ahv_hosts }}"
          loop_control:
            loop_var: current_host
          when:
            - ahv_hosts | length > 0
            - not (read_from_file | bool)
    
        - name: 4. Construct final input_filter dictionary
          ansible.builtin.set_fact:
            input_filter:
              stdout: "{{ input_filter_stdout_list | join('\n') }}"
              stdout_lines: "{{ input_filter_lines_list }}"

    - name: 5. Mimic 'cat' register output using lookup
      set_fact:
        input_filter:
          stdout: "{{ lookup('file', 'data.45.testing11_hostssh_no_nvidia_smi_logic.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.45.testing11_hostssh_no_nvidia_smi_logic.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool
    
    - name: 6. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 
    
    - name: 7. Match the regex
      set_fact:
        gpu_matches: >-
          {{ input_filter.stdout | regex_findall('NVIDIA A100-SXM.*\n.*?(\d+)MiB / (\d+)MiB') }}
    
    - name: 8. Calculating 1 
      set_fact:
        answer: >-
          {% if gpu_matches | length == 0 %}
          None
          {% else %}
          {% set ns = namespace(exceed=false) %}
          {% for item in gpu_matches %}
            {% set used = item[0] | int %}
            {% set total = item[1] | int %}
            {% if (used / total) > 0.9 %}
              {% set ns.exceed = true %}
            {% endif %}
          {% endfor %}
          {{ 'Failed' if ns.exceed else 'Storage OK' }}
          {% endif %}
    
    - name: 9. Calculating 2 
      set_fact:
        remark: >-
          {% set ns = namespace(msg='') %}
          {% for item in gpu_matches %}
            {% set used = item[0] | int %}
            {% set total = item[1] | int %}
            {% if (used / total) > 0.9 %}
              {% set ns.msg = 'more than 0.9' %}
            {% endif %}
          {% endfor %}
          {{ ns.msg }}
    
    - name: 10. Display remark
      debug:
          var: remark
    
    - name: 10. Display answer
      debug:
          var: answer

    - name: 97. Log to local
      import_tasks: subr.log_local.yml
      when: log_local_enabled | bool

    - name: 98. Log to external
      import_tasks: subr.log_ext.yml
      when: log_ext_enabled | bool

    - name: 99. Log to local
      import_tasks: subr.log_github.yml
      when: log_github_enabled | bool

