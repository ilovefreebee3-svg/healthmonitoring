
---------------------------------
51_testing11_ncc_health_checks_run_all_gg_command.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Fetch and process Nutanix NCC health check log
  hosts: corecvm
  gather_facts: false

  vars:
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    log_github_enabled: false 

  tasks:
    - name: 1. Declare variables
      ansible.builtin.set_fact:
        log_path: "/home/nutanix/data/logs/ncc-output.log"
        csv_report_path: "./tmp/ncc_health_summary.csv"

    - name: 2. Check if the log file exists
      ansible.builtin.stat:
        path: "{{ log_path }}"
      register: log_stat

    - name: 3. Handle missing log file
      ansible.builtin.set_fact:
        answer: "No log found"
        remark: "Last checked: {{ lookup('pipe', 'date +%Y-%m-%d') }}"
      when: not log_stat.stat.exists

    - name: 4. Process log when file exists
      when: log_stat.stat.exists
      block:
        - name: Fetch the log file to the Ansible control node
          ansible.builtin.fetch:
            src: "{{ log_path }}"
            dest: "./tmp/"
            flat: true

        - name: Isolate the last TIMESTAMP block using awk
          # Every time awk hits '# TIMESTAMP', it clears the buffer variable 'b'.
          # 'b = b $0 ORS' continuously appends lines until the end of the file (END).
          ansible.builtin.command:
            cmd: "awk '/# TIMESTAMP/{b=\"\"} {b=b $0 ORS} END{printf \"%s\", b}' {{ log_path }}"
          register: trimmed_log_output
          changed_when: false

        - name: Parse and cast the trimmed log counters strictly
          vars:
            log_text: "{{ trimmed_log_output.stdout }}"
            log_lines: "{{ log_text.splitlines() }}"
            
            # Grabs the very first line of this newly isolated block
            timestamp_raw: "{{ log_lines | select('search', 'TIMESTAMP') | first | default('') }}"
            timestamp_clean: "{{ timestamp_raw | regex_replace('^#\\s*TIMESTAMP\\s*', '') | regex_replace('\\s*#$', '') }}"
            
            # Find the summary metrics inside this isolated block
            fail_line: "{{ log_text | regex_search('\\|\\s*Fail\\s*\\|\\s*\\d+\\s*\\|') | default('| Fail | 0 |') }}"
            error_line: "{{ log_text | regex_search('\\|\\s*Error\\s*\\|\\s*\\d+\\s*\\|') | default('| Error | 0 |') }}"
            
            # Extract digits exclusively
            fail_digits: "{{ fail_line | regex_replace('[^0-9]', '') | default('0') }}"
            error_digits: "{{ error_line | regex_replace('[^0-9]', '') | default('0') }}"
          ansible.builtin.set_fact:
            _saved_fail: "{{ fail_digits | int }}"
            _saved_error: "{{ error_digits | int }}"
            _saved_ts: "{{ timestamp_clean | trim }}"

        - name: Evaluate final cluster health parameters
          ansible.builtin.set_fact:
            answer: "{{ 'Unhealthy' if (_saved_fail | int > 0 or _saved_error | int > 0) else 'Healthy' }}"
            remark: >-
              {% if _saved_fail | int > 0 or _saved_error | int > 0 -%}
              Last updated: {{ _saved_ts }} (Fails: {{ _saved_fail }}, Errors: {{ _saved_error }})
              {%- else -%}
              Last updated: {{ _saved_ts }}
              {%- endif %}

    - name: Ensure CSV report directory exists on control node
      ansible.builtin.file:
        path: "{{ csv_report_path | dirname }}"
        state: directory
        mode: '0755'
      delegate_to: localhost
      connection: local 
      run_once: true

    - name: Ensure CSV header line is present on control node
      ansible.builtin.lineinfile:
        path: "{{ csv_report_path }}"
        line: "Host,Status,Remark"
        create: true
        mode: '0644'
      delegate_to: localhost
      connection: local 
      run_once: true

    - name: Append current host status summary to CSV file
      ansible.builtin.lineinfile:
        path: "{{ csv_report_path }}"
        line: '"{{ inventory_hostname }}","{{ answer }}","{{ remark | trim }}"'
      delegate_to: localhost
      connection: local 

    - name: Debug variables to verify results
      ansible.builtin.debug:
        msg:
          - "Answer: {{ answer }}"
          - "Remark: {{ remark }}"

    - name: 99. Include persistency
      ansible.builtin.include_tasks: incl.logging.yml
------------------------------------------------------------------


