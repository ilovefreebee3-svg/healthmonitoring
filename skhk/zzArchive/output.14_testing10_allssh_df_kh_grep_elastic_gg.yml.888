
---------------------------------
14_testing10_allssh_df_kh_grep_elastic_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Master Playbook to Execute and Process Multiple AllSSH Commands
#  hosts: calmcvm
  hosts: calmcvm
  gather_facts: false

  tasks:
    # ------------------------------------------------------------
    # UPFRONT REACHABILITY: Ensures the target control CVM itself is online
    # ------------------------------------------------------------
    - name: Verify connectivity to the Control CVM
      ansible.builtin.wait_for_connection:
        timeout: 5
      register: control_cvm_status

    # ------------------------------------------------------------
    # SCENARIO 2: Run 'df -kh' and process the output
    # ------------------------------------------------------------
    - name: 1. Run df -kh and status check across all CVMs
      ansible.builtin.include_tasks: subr.run_allssh.yml
      vars:
        target_cmd: "df -kh"

#    - name: 2. Execute a remote script
#      ansible.builtin.command: name_of_remote_script
#      register: input_filter
#      changed_when: false
#      ignore_errors: true

#    - name: 3. Read from hardcoded file
#      set_fact:
#        input_filter:
#          stdout: "{{ lookup('file', 'data.allssh_df_kh_grep_elastic_gg_PG.txt') }}"
#          stdout_lines: "{{ lookup('file', 'data.allssh_df_kh_grep_elastic_gg_PG.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false

    - name: 4. Initialise variables
      set_fact:
        remark_list: []
        status_tracker: []

    - name: 5. Display input_filter.stdout_lines
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 

    - name: 6. Isolate blocks by delimiter
      ansible.builtin.set_fact:
        raw_blocks: "{{ input_filter.stdout.split('==========') }}"

    - name: 7. Process each host block dynamically
      ansible.builtin.set_fact:
        # Extract the IP from the odd index item, clean up trailing characters
        current_ip: "{{ raw_blocks[item] | replace('=', '') | trim }}"
        # Extract the terminal output content from the next even index item
        current_content: "{{ raw_blocks[item + 1] | default('') }}"
      # Loop through only the odd indices where the IP addresses sit
      loop: "{{ range(1, raw_blocks | length, 2) | list }}"
      register: block_results

    - name: 8. Aggregate results into final structures
      ansible.builtin.set_fact:
        remark_list: >-
          {{ remark_list + [ 
               item.ansible_facts.current_ip ~ ' --- ' ~ 
               ('Elasticsearch function found' if 'elasticsearch' in item.ansible_facts.current_content else 'Elasticsearch function not found') 
             ] }}
        status_tracker: >-
          {{ status_tracker + [ 
               'found' if 'elasticsearch' in item.ansible_facts.current_content else 'not found' 
             ] }}
      loop: "{{ block_results.results }}"

    - name: 9. Finalise scalar answer and remark variables
      ansible.builtin.set_fact:
        remark: "{{ remark_list | join('\n') }}"
        answer: "{{ 'Elasticsearch function not found' if 'not found' in status_tracker else 'Elasticsearch function found' }}"

    - name: 10. Display Results
      ansible.builtin.debug:
        msg:
          - "REMARK:"
          - "{{ remark }}"
          - "-----------------------------------"
          - "ANSWER: {{ answer }}"

    - name: 11. Append result to CSV (local)
      import_tasks: logd.yml

#    - name: 99. Include common role
#      ansible.builtin.include_role:
#         name: common
    
------------------------------------------------------------------


