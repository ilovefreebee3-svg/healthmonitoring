
---------------------------------
33_testing11_mspctl_cluster_health_command_msp.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: how to run mspctl cluster health
  hosts: calmcvm
#  hosts: pccvm
  gather_facts: false

  vars:
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    log_github_enabled: false 
    description: mspctl cluster health msp
    idx: idx057
    role: r_mspctl_cluster_health_msp

  tasks:
    - name: 1. Declare variables
      set_fact:
        cluster: "msp"
        num_unhealthy: 0
        remark: ""

    - name: 2. Run mspctl cluster health {{ cluster }} with command module
      ansible.builtin.command:
        argv:
          - /bin/bash
          - -c
          - |
            source /etc/profile
            mspctl cluster health {{ cluster }}
      register: input_result
      changed_when: false
      failed_when: false
      when: not ( read_from_file | bool )

    - name: 3. Mimic 'cat' register output 
      set_fact:
        input_result:
          stdout: "{{ lookup('file', 'data.33_testing11_mspctl_cluster_health_command_msp.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.33_testing11_mspctl_cluster_health_command_msp.txt').splitlines() }}"
          stderr: ""
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool

    - name: 4. Display input_result.stdout_lines
      ansible.builtin.debug:
        var: input_result.stdout_lines

    - name: 5. Display input_result.stdout
      ansible.builtin.debug:
        var: input_result.stdout

    - name: 6. Display input_result.stderr
      ansible.builtin.debug:
        var: input_result.stderr

    - name: 7. Display the return code
      ansible.builtin.debug:
        var: input_result.rc

    - name: 8. Process each line
      set_fact:
        num_unhealthy: "{{ num_unhealthy | int + (1 if healthy | lower != 'true' else 0) }}"
        remark: >-
          {{ remark +
          (component ~ ':' ~ healthy ~ ' ' if healthy | lower != 'true' else '') }}
      loop: "{{ input_result.stdout_lines }}"
      loop_control:
        loop_var: cluster_line
      vars:
        line: "{{ cluster_line | trim }}"
        is_valid: "{{ line != '' and not line.startswith('COMPONENT') }}"
        parsed: "{{ line | regex_findall('^(\\S+)\\s+(\\S+)\\s+(.*)$') }}"
        component: "{{ parsed[0][0] if parsed else '' }}"
        healthy: "{{ parsed[0][1] if parsed else '' }}"
      when: is_valid and parsed | length > 0

    - name: 9. Final answer
      set_fact:
        answer: "{{ 'Unhealthy' if (num_unhealthy | int) > 0 else 'Healthy' }}"
    
    - name: 10. Show results
      debug:
        msg:
          num_unhealthy: "{{ num_unhealthy }}"
          remark: "{{ remark }}"
          answer: "{{ answer }}"

    - name: 99. Include persistency
      ansible.builtin.include_tasks: incl.logging.yml
------------------------------------------------------------------


