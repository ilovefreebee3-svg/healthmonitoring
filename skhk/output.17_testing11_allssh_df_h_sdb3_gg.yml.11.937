
---------------------------------
17_testing11_allssh_df_h_sdb3_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Running df -h /dev/sdb3
  hosts: calmcvm
#  hosts: pccvm
#  hosts: allcvms
  gather_facts: false

  vars:
    read_from_file: false 
    logd_enabled: false 
    role_enabled: false 
    log_filesystem_enabled: false 
    log_github_enabled: false 
    description: allssh 'df -h /dev/sdb3'
    idx: idx062
    role: r_allssh_df_sdb3_gg

  tasks:
    # ------------------------------------------------------------
    # UPFRONT REACHABILITY: Ensures the target control CVM itself is online
    # ------------------------------------------------------------
    - name: 0. set disk threshold
      set_fact:
        disk_threshold_pct: 80

    - name: 0. Verify connectivity to the Control CVM
      ansible.builtin.wait_for_connection:
        timeout: 5
      register: control_cvm_status

    # ------------------------------------------------------------
    # SCENARIO 2: Run 'df -h /dev/sdb3' and process the output
    # ------------------------------------------------------------
    - name: 1. Run df -h 
      ansible.builtin.include_tasks: subr.run_allssh.yml
      vars:
        target_cmd: "df -h /dev/sdb3"
      when: not ( read_from_file | bool )

    - name: 3. Read from hardcoded file
      set_fact:
        input_filter:
          stdout: "{{ lookup('file', 'data.17_testing11_allssh_df_h_sdb3_gg.txt') }}"
          stdout_lines: "{{ lookup('file', 'data.17_testing11_allssh_df_h_sdb3_gg.txt').splitlines() }}"
          rc: 0
          failed: false
          changed: false
      when: read_from_file | bool

    - name: 4. Display input_filter 1
      ansible.builtin.debug:
        msg: "{{ input_filter.stdout_lines }}" 

    - name: 5. Parse and Analyze Disk Usage
      ansible.builtin.set_fact:
        disk_reports: >-
          {% set reports = [] %}
          {% set vars = namespace(current_ip='Unknown') %}
          {% for line in input_filter.stdout_lines %}
            {% if '==========' in line %}
              {% set found_ip = line | regex_search('[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}') %}
              {% if found_ip %}
                {% set vars.current_ip = found_ip %}
              {% endif %}
            {% elif '/dev/sdb3' in line %}
              {% set parts = line.split() %}
              {% set use_pct_raw = parts[4] | regex_replace('%', '') | int %}
              {% set _ = reports.append({'ip': vars.current_ip, 'filesystem': parts[0], 'use_pct': use_pct_raw}) %}
            {% endif %}
          {% endfor %}
          {{ reports | to_json }}

    - name: 6. Convert JSON String to Real Ansible List
      ansible.builtin.set_fact:
        disk_reports_list: "{{ disk_reports | from_json }}"

    - name: 7. Evaluate Thresholds and Filter Exceeded Nodes
      ansible.builtin.set_fact:
        exceeded_nodes: "{{ disk_reports_list | selectattr('use_pct', 'greaterthan', disk_threshold_pct | int) | list }}"

    - name: 8. Evaluate Thresholds and Filter Exceeded Nodes
      ansible.builtin.set_fact:
        exceeded_nodes: "{{ disk_reports_list | selectattr('use_pct', 'greaterthan', disk_threshold_pct | int) | list }}"

    - name: 9. Finalize Answer and Remark Variables
      ansible.builtin.set_fact:
        answer: "{{ 'Disk space /dev/sdb3 exceeded' if exceeded_nodes | length > 0 else 'Disk space OK' }}"
        remark: >-
          {% if exceeded_nodes | length > 0 %}
          {% for node in exceeded_nodes %}
          IP: {{ node.ip }}
          Filesystem: {{ node.filesystem }}
          Use%: {{ node.use_pct }}%
          {% if not loop.last %}

          {% endif %}
          {% endfor %}
          {% else %}
          None
          {% endif %}

    - name: 10. Debug Output
      ansible.builtin.debug:
        msg:
          - "Answer: {{ answer }}"
          - "Remark:"
          - "{{ remark.strip() }}"

    - name: 99. Include persistency
      ansible.builtin.include_tasks: incl.logging.yml
------------------------------------------------------------------


