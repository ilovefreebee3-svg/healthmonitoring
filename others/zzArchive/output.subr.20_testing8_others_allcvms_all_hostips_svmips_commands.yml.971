
---------------------------------
subr.20_testing8_others_allcvms_all_hostips_svmips_commands.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Display host and command
  debug:
    msg:
      - "Host    : {{ inventory_hostname }}"
      - "Command : {{ cmd.name }}"

- name: 2. Run command
#  ansible.builtin.command:
#    argv: "{{ cmd.argv }}"
  ansible.builtin.command:
    argv:
      - /bin/bash
      - -c
      - |
        source /etc/profile
        {{ cmd.name }}
  register: input_result
  changed_when: false
  failed_when: false

- name: 3. Debug the captured output
  ansible.builtin.debug:
    var: input_result.stdout_lines

- name: 4. Display the captured output
  ansible.builtin.debug:
    var: input_result.stdout

- name: 5. Display {{ cmd.argv }} command output
  debug:
    msg: |
      ==================================================
      Host    : {{ inventory_hostname }}
      Command : {{ cmd.name }}
      RC      : {{ input_result.rc }}

      STDOUT:
      {{ input_result.stdout_lines | default('') }}

      STDERR:
      {{ input_result.stderr | default('') }}
      ==================================================

- name: 6. Log output on control node
  ansible.builtin.blockinfile:
    path: ./tmp/00_run_all_hostssh_commands.log
    create: true
    marker: ""
    block: |
      ==================================================
      Host    : {{ inventory_hostname }}
      Command : {{ cmd.name }}
      RC      : {{ input_result.rc }}

      STDOUT_LINES:
      {{ input_result.stdout_lines | default('') }}

      STDOUT:
      {{ input_result.stdout | default('') }}

      STDERR:
      {{ input_result.stderr | default('') }}
      ==================================================
  delegate_to: localhost
------------------------------------------------------------------
