
---------------------------------
19_testing8_others_all_hostips_svmips_commands.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Run diagnostic commands on all AHVs
  hosts: pccvm
  gather_facts: false
  serial: 1

  vars:
    cmd_list:
      - name: hostips
        argv: ["hostips"]

      - name: svmips
        argv: ["svmips"]

  tasks:
    - name: Execute commands
      include_tasks:  subr.19_testing8_others_all_hostips_svmips_commands.yml
      loop: "{{ cmd_list }}"
      loop_control:
        loop_var: cmd
