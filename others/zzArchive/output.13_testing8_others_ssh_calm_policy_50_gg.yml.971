
---------------------------------
13_testing8_others_ssh_calm_policy_50_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Check calm policy
  hosts: allcvms
  gather_facts: false

  tasks:
    - name: Execute df command
      ansible.builtin.command: df -kh
      register: input_result
      changed_when: false

    - name: Set default variables
      set_fact:
        monitored_mounts: ["/", "/home", "/var"]
        threshold: 50
    
#    - name: Mimic 'cat' register output using lookup
#      set_fact:
#        input_result:
#          stdout: "{{ lookup('file', 'ssh_calm_policy_gg.txt') }}"
#          stdout_lines: "{{ lookup('file', 'ssh_calm_policy_gg.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false
    
    - name: Display input_result 1
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 
    
    - name: Display input_result 2
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 
    
    - name: Process Disk Data
      ansible.builtin.set_fact:
        # Calculate values inside a single block to ensure logic sync
        disk_stats: >-
          {%- set results = [] -%}
          {%- for line in input_result.stdout_lines[1:] -%}
            {%- set cols = line.split() -%}
            {%- if cols | length >= 6 -%}
              {%- set mount = cols[5] -%}
              {%- set usage = cols[4] | replace('%', '') | int -%}
              {%- if mount in monitored_mounts and usage > threshold -%}
                {%- set _ = results.append(mount ~ " (" ~ usage ~ "%)") -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {{ {
            'count': results | length,
            'remark_list': results
          } | from_yaml }}
    
    - name: Assign final variables
      ansible.builtin.set_fact:
        num_over75: "{{ disk_stats.count }}"
        answer: "{{ (disk_stats.count > 0) | ternary('Threshold exceeded', 'Threshold not exceeded') }}"
        remark: "{{ disk_stats.remark_list | join(', ') if disk_stats.count > 0 else 'All clear' }}"
    
    - name: Display Result Information
      ansible.builtin.debug:
        msg: 
          - "IP: {{ ansible_default_ipv4.address | default(inventory_hostname) }}"
          - "Status: {{ answer }}"
          - "Threshold: {{ threshold }}"
          - "Count: {{ num_over75 }}"
          - "Details: {{ remark }}"
    
    - name: Append result to CSV (local)
      import_tasks: logd.yml
