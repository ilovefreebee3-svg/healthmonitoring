
---------------------------------
03_testing8_others_cs_grep_v_down_command_gg.yml
---------------------------------

++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
---
- name: Check CVM service status
  hosts: pccvm
  gather_facts: false

  tasks:
    - name: Execute cs command
      ansible.builtin.command: /home/nutanix/cluster/bin/cluster status
#      ansible.builtin.shell: /home/nutanix/cluster/bin/cluster status
#      ansible.builtin.command: cs_grep_v_up_gg
      register: input_result
      changed_when: false

    - name: Mimic 'cat' register output using lookup
      set_fact:
        down_services: []
#        input_result:
#          stdout: "{{ lookup('file', 'cs_grep_v_up_gg.txt') }}"
#          stdout_lines: "{{ lookup('file', 'cs_grep_v_up_gg.txt').splitlines() }}"
#          rc: 0
#          failed: false
#          changed: false
    
    - name: Display input_result 1
      ansible.builtin.debug:
        msg: "{{ input_result.stdout_lines }}" 
    
    - name: Parse output and evaluate status
      ansible.builtin.set_fact:
        down_services: >-
          {%- set lines = input_result.stdout_lines -%}
          {%- set filtered = [] -%}
          {%- for raw_line in lines -%}
            {%- set line = raw_line.replace(',', ' ') -%}
            {%- if 'CVM' in line -%}
              {%- set cols = line.split() -%}
              {%- if cols | length >= 3 and cols[2] != 'Down' -%}
                {%- set _ = filtered.append({'ip': cols[1], 'status': cols[2]}) -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {{ filtered }}
    
    - name: Set final answer and remark variables
      ansible.builtin.set_fact:
        answer: "{{ 'CVM service(s) down' if down_services | length > 0 else 'CVM service(s) all Up' }}"
        remark: "{{ down_services if down_services | length > 0 else 'All services healthy' }}"
    
    - name: Display results
      ansible.builtin.debug:
        msg:
          - "Answer: {{ answer }}"
          - "Remark: {{ remark }}"
    
    - name: Append result to CSV (local)
      import_tasks: logd.yml
------------------------------------------------------------------


