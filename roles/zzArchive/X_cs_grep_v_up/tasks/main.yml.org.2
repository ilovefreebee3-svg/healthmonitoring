---
#- name: Run cs | grep -v Up
#  ansible.builtin.command: "cs | grep -v Up"
#  register: input_result
#  changed_when: false

- name: Mimic 'cat' register output using lookup
  set_fact:
    input_result:
      stdout: "{{ lookup('file', 'cs_grep_v_UP.txt') }}"
      stdout_lines: "{{ lookup('file', 'cs_grep_v_UP.txt').splitlines() }}"
      rc: 0
      failed: false
      changed: false

- name: Display input_result 1
  ansible.builtin.debug:
    msg: "{{ input_result.stdout_lines }}" 

- name: Display input_result 2
  ansible.builtin.debug:
    msg: "{{ input_result.stdout_lines }}" 

- name: Initialize variables
  set_fact:
    num_down: 0
    remark: ""
    num_cvm: 0

- name: Process CVM lines with regex
  set_fact:
    num_cvm: "{{ (num_cvm | int) + 1 }}"
    num_down: "{{ (num_down | int) + (1 if state != 'Up' else 0) }}"
    remark: >-
      {{ remark + (ipaddress ~ ' (' ~ state ~ '), ' if state != 'Up' else '') }}
  vars:
    match: "{{ item | regex_search('CVM:\\s+(\\S+)\\s+(Up|Down)', '\\1', '\\2') }}"
    ipaddress: "{{ match[0] if match else '' }}"
    state: "{{ match[1] if match else '' }}"
  loop: "{{ input_result.stdout_lines }}"
  when:
    - "'CVM:' in item"
    - match is defined
    - match | length >= 2

- name: Final result
  set_fact:
    answer: >-
      {% if (num_cvm | int) == 0 %}
      Fail
      {% elif (num_down | int) > 0 %}
      Some CVMs not up
      {% else %}
      All CVMs Up
      {% endif %}
    remark: >-
      {% if (num_cvm | int) == 0 %}
      No CVM entries found
      {% else %}
      {{ remark }}
      {% endif %}

- debug:
    var: answer

- debug:
    var: remark

- name: Include common role
  ansible.builtin.include_role:
     name: common
