---
- name: Execute allssh disk free command
#  ansible.builtin.command: "allssh 'df -kh | grep -e elastic -e /dev/sdb3'"
  ansible.builtin.command: "allssh 'df -kh'"
  register: input_result
  changed_when: false

- name: Mimic 'cat' register output using lookup
  set_fact:
    disk_threshold_pct: 75
#    input_result:
#      stdout: "{{ lookup('file', 'allssh_df_kh_grep_elastic_sdb3_gg.txt') }}"
#      stdout_lines: "{{ lookup('file', 'allssh_df_kh_grep_elastic_sdb3_gg.txt').splitlines() }}"
#      rc: 0
#      failed: false
#      changed: false

- name: Display input_result 1
  ansible.builtin.debug:
    msg: "{{ input_result.stdout_lines }}" 

- name: Parse output and evaluate disk thresholds
  ansible.builtin.set_fact:
    _parsed_results: >-
      {%- set context = namespace(current_ip='Unknown', matches=[]) -%}
      {%- for line in input_result.stdout_lines -%}
        {%- if '==========' in line -%}
          {# Extract only the clean IP address from the separator line #}
          {%- set extracted_ip = line | regex_search('(?:[0-9]{1,3}\.){3}[0-9]{1,3}') -%}
          {%- set context.current_ip = extracted_ip if extracted_ip else 'Unknown' -%}
        {%- elif 'elastic' in line or '/dev/sdb3' in line -%}
          {%- set parts = line.split() -%}
          {%- if parts | length >= 5 -%}
            {# Identify Use% and Filesystem columns from df output #}
            {%- set use_pct_str = parts[4] if '%' in parts[4] else parts[3] -%}
            {%- set use_pct = use_pct_str | replace('%', '') | int -%}
            {%- set filesystem = parts[0] -%}
            {%- if use_pct > disk_threshold_pct | int -%}
              {# Build the entry with newline delimiters and no ==== markings #}
              {%- set entry = context.current_ip ~ " - " ~ filesystem ~ " - " ~ use_pct_str -%}
              {%- set context.matches = context.matches + [entry] -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {{ context.matches }}

- name: Set final answer and remark variables
  ansible.builtin.set_fact:
    answer: "{{ (_parsed_results | length > 0) | ternary('Disk space exceeded', 'Disk space OK') }}"
    remark: "{{ _parsed_results | join(' -- ') if _parsed_results | length > 0 else '' }}"

- name: Display Results
  ansible.builtin.debug:
    msg:
      - "Disk threshold: {{ disk_threshold_pct }}%"
      - "Answer: {{ answer }}"
      - "Remark:\n{{ remark }}"

- name: Include common role
  ansible.builtin.include_role:
     name: common
